# Copy this file to ".env" and edit the values.

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# --- Database ---------------------------------------------------------------
# Leave DB_HOST empty to use the built-in JSON file database (data/db.json).
# Fill these in to use MySQL (XAMPP / MySQL Server). The database and tables
# are created automatically on first start (see database/schema.sql).
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ampon_pet_adoption
